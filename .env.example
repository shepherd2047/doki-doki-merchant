# https://fish.audio/app/api-keys (or put it in fish-hackathon/fish-audio/.env)
FISH_API_KEY=
# The Merchant's designed voice ("shriek_1"), from scripts/design-voice.mjs
FISH_VOICE_ID=
# Printed by `npm run create-agent`
MERCHANT_AGENT_ID=
# The bestie's designed voice, from `node scripts/narrate.mjs save bestie_1`
NARRATOR_VOICE_ID=
# Printed by `node scripts/create-bestie.mjs`
BESTIE_AGENT_ID=
# en or zh
MERCHANT_LANGUAGE=en
